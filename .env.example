# En Cloud Run, API_KEY NO viene de aquí: se inyecta desde Secret Manager.

# Puerto de la API (Cloud Run lo define automáticamente
PORT=8080

# Valor de prueba. En GCP vive en Secret Manager (secreto "tramites-api-key").
API_KEY=xxxx

# Versión mostrada en /health (en el pipeline se usa el SHA/SemVer de la imagen)
APP_VERSION=0.0.0-local